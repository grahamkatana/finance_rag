# PostgreSQL
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_password
POSTGRES_DB=rag_finance
POSTGRES_HOST=localhost
POSTGRES_PORT=5436

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=finance_docs

# Generation
LLM_PROVIDER=ollama
LLM_MODEL=phi4-mini
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=

# Embeddings
EMBED_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text
EMBED_BASE_URL=http://localhost:11434
EMBED_API_KEY=
EMBEDDING_SIZE=768

# Eval Judge
JUDGE_PROVIDER=ollama
JUDGE_MODEL=gemma3:4b
JUDGE_BASE_URL=http://localhost:11434
JUDGE_API_KEY=

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Auth
JWT_SECRET=change-me-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin seed (set these to auto-create an admin on first startup)
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production

# App
APP_ENV=development
APP_PORT=8000
